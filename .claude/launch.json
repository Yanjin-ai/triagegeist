{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "triage-ui",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8077", "--directory", "app"],
      "port": 8077
    },
    {
      "name": "triage-serve",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "src.serve.app"],
      "port": 8078
    },
    {
      "name": "assets",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8079", "--directory", "docs/assets"],
      "port": 8079
    }
  ]
}
